{
  "name": "zotero-s2",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Semantic Scholar for Zotero 10, served to AI agents over MCP",
  "keywords": [
    "zotero",
    "zotero-plugin",
    "semantic-scholar",
    "mcp",
    "model-context-protocol",
    "ai-agents"
  ],
  "config": {
    "addonName": "Zotero S2",
    "addonID": "zotero-s2@dingzy53.github.io",
    "addonRef": "zoteros2",
    "addonInstance": "ZoteroS2",
    "prefsPrefix": "extensions.zotero.zoteros2"
  },
  "author": "Ding Zheng Yuan",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingzy53/zotero-S2.git"
  },
  "bugs": {
    "url": "https://github.com/dingzy53/zotero-S2/issues"
  },
  "homepage": "https://github.com/dingzy53/zotero-S2#readme",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^6.0.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
