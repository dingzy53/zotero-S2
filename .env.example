# Copy to `.env` (gitignored) and fill in. Variables already set in your
# environment can be left out here.

# Zotero 10 binary. On Linux, unpack the official tarball outside the repo:
#   https://www.zotero.org/download/client/dl?channel=release&platform=linux-x86_64
# macOS: /Applications/Zotero.app/Contents/MacOS/zotero
# Windows: escape backslashes, e.g. C:\\Program Files\\Zotero\\zotero.exe
ZOTERO_PLUGIN_ZOTERO_BIN_PATH = /path/to/zotero

# Profile for `npm start`. Create one with `/path/to/zotero -p`.
# Never point this at your everyday Zotero profile.
# https://www.zotero.org/support/kb/profile_directory
ZOTERO_PLUGIN_PROFILE_PATH = /path/to/dev-profile

# Data directory for `npm start`. Empty uses the profile's default.
# Never point this at your everyday Zotero data directory.
ZOTERO_PLUGIN_DATA_DIR =

# Only needed for releasing from your machine instead of CI.
# GITHUB_TOKEN =
